#!/usr/bin/env bash
# kingdom — launch kingdom sessions with the citadel brain attached.
#   kingdom cycle <realm> [-p|--print] [--model M] [--effort E]   run one /cycle (interactive unless -p)
#   kingdom shell <realm>                                          interactive session in a realm, brain attached
#   kingdom argv  <realm>                                          print the claude argv (used by jobs.py)
#   kingdom status                                                 delegate to /status in citadel
set -euo pipefail
CITADEL="$(cd "$(dirname "$0")/.." && pwd)"
CODESPACE="$(dirname "$CITADEL")"

usage() { sed -n '2,7p' "$0"; exit 1; }
cmd="${1:-}"; shift || usage
case "$cmd" in
  cycle|shell|argv)
    realm="${1:?realm required}"; shift
    repo="$CODESPACE/$realm"; [ -d "$repo" ] || { echo "no such realm dir: $repo" >&2; exit 2; }
    settings="$CITADEL/realms/$realm/settings.json"
    [ -f "$settings" ] || { echo "missing $settings — run: python3 scripts/jobs.py render" >&2; exit 2; }
    model="sonnet"; effort="high"; print=0
    while [ $# -gt 0 ]; do case "$1" in
      -p|--print) print=1;; --model) model="$2"; shift;; --effort) effort="$2"; shift;; *) echo "unknown arg $1" >&2; exit 2;; esac; shift; done
    prompt="/cycle $realm"
    export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1   # citadel/.claude/rules + CLAUDE.md load via --add-dir
    mapfile_args=$(python3 "$CITADEL/scripts/jobs.py" argv "$realm") || exit 2
    common=()
    while IFS= read -r a; do common+=("$a"); done <<< "$mapfile_args"
    common+=(--append-system-prompt-file "$CITADEL/core/CONTRACT.md" --permission-mode bypassPermissions --model "$model")
    [ "$effort" != high ] && common+=(--effort "$effort")
    if [ "$cmd" = argv ]; then printf '%s\n' "${common[@]}"; exit 0; fi
    cd "$repo"
    if [ "$cmd" = shell ]; then exec claude "${common[@]}"; fi
    if [ $print = 1 ]; then exec claude -p "$prompt" --output-format json --verbose "${common[@]}"; fi
    exec claude "${common[@]}" "$prompt"
    ;;
  status) cd "$CITADEL" && exec claude "/status" ;;
  *) usage ;;
esac
