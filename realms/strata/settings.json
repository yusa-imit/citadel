{
  "$comment": "Rendered per realm into realms/<realm>/settings.json by scripts/jobs.py render (strata). Permission lists are moot under bypassPermissions; the hooks are the enforcement.",
  "autoMemoryDirectory": "/Users/fn/.claude/kingdom-memory/strata",
  "permissions": {
    "allow": ["Bash(zig:*)", "Bash(git:*)", "Bash(gh:*)", "Bash(openclaw message send:*)"],
    "deny": ["Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)", "Bash(git add -A:*)", "Bash(git add .:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 /Users/fn/codespace/citadel/scripts/hooks/guard_bash.py" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python3 /Users/fn/codespace/citadel/scripts/hooks/guard_write.py" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 /Users/fn/codespace/citadel/scripts/hooks/zig_fmt.py" }]
      }
    ]
  }
}
